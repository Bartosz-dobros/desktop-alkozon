# For local development:
API_BASE_URL=http://localhost:8080/api
# For production API (get the actual URL from your dev ops team):
# API_BASE_URL=https://your-api-domain.com/api

# Request timeout in seconds (increase for slow connections or Render free tier wake-up)
API_TIMEOUT=60

# Debug mode (true/false)
DEBUG=false

# Demo mode (true/false) - shows "Enter Demo Mode" button for testing
DEMO_MODE=false

# Note: Never commit .env file - it contains environment-specific settings
# .env.example is safe to commit as it contains no real credentials

